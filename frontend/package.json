{
  "name": "@trackly/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port ${FRONTEND_PORT:-3000}",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${FRONTEND_PORT:-3000}",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "cross-env NEXT_PUBLIC_API_URL=http://localhost:4000 NEXT_PUBLIC_AUTH_URL=http://localhost:4000 vitest run",
    "test:watch": "cross-env NEXT_PUBLIC_API_URL=http://localhost:4000 NEXT_PUBLIC_AUTH_URL=http://localhost:4000 vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "axios": "^1.11.0",
    "better-auth": "1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.536.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.1.2",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
